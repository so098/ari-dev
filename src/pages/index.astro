---
import BlogCard from '@/components/BlogCard.astro'
import KnowledgeTile from '@/components/KnowledgeTile.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import Layout from '@/layouts/Layout.astro'
import { getAllKnowledge, getRecentPosts } from '@/lib/data-utils'

const posts = await getRecentPosts(7)
const knowledge = await getAllKnowledge()
---

<Layout>
  <PageHead slot="head" title="Home" />
  <section>
    <div class="border-b pb-5">
      <div class="pt-0">
        <p class="text-muted-foreground mb-2 text-sm">
          프론트엔드 개발자 ari의 기술 기록 공간입니다.
        </p>
        <p class="text-muted-foreground mb-2 text-sm">
          특히 프론트엔드 인증·보안을 깊이 다룹니다. HttpOnly 쿠키 하이브리드
          인증을 실제 서비스에 1년 4개월 운영한 경험을 바탕으로, 토큰 저장
          전략·SameSite Lax 한계·Refresh Token Rotation·CSRF까지 정리합니다.
        </p>
      </div>
    </div>
  </section>

  <section class="flex flex-col gap-y-4">
    <Link
      href="/security"
      class="hover:border-foreground/30 group rounded-xl border p-4 transition-colors"
    >
      <div class="flex items-start justify-between gap-4">
        <div>
          <p class="text-foreground/60 text-xs">Featured</p>
          <h2 class="mt-1 font-medium">Security 시리즈 →</h2>
          <p class="text-muted-foreground mt-2 text-sm">
            HttpOnly 하이브리드 인증·SameSite Lax 한계·Refresh Rotation·CSRF —
            한국어로 정리된 프론트엔드 인증·보안 자료 4편을 한 곳에서.
          </p>
        </div>
      </div>
    </Link>
  </section>
  {
    knowledge.length > 0 && (
      <section class="flex flex-col gap-y-4">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-2xl font-medium">Knowledge</h2>
          <Link
            href="/knowledge"
            class="text-muted-foreground hover:text-foreground group flex shrink-0 items-center text-sm transition-colors"
          >
            See more
            <span class="ml-1 transition-transform group-hover:translate-x-1">
              &rsaquo;
            </span>
          </Link>
        </div>
        <p class="text-muted-foreground text-sm">
          JavaScript Weekly와 안드레이 카파시, OpenClaw, OpenAI, Anthropic,
          React, Next.js 관련 최신 글을 자동으로 수집해 정리합니다. 직접 정리한 글도
          함께 포함됩니다.
        </p>
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {knowledge.slice(0, 3).map((entry) => (
            <li class="h-full">
              <KnowledgeTile entry={entry} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="flex flex-col gap-y-4">
    <div class="flex items-center justify-between gap-4">
      <h2 class="text-2xl font-medium">Blog posts</h2>
      <Link
        href="/blog"
        class="text-muted-foreground hover:text-foreground group flex shrink-0 items-center text-sm transition-colors"
      >
        See more
        <span class="ml-1 transition-transform group-hover:translate-x-1">
          &rsaquo;
        </span>
      </Link>
    </div>
    <ul class="flex flex-col gap-y-4">
      {
        posts.map((post) => (
          <li>
            <BlogCard entry={post} />
          </li>
        ))
      }
    </ul>
  </section>
</Layout>
