---
import BlogCard from '@/components/BlogCard.astro'
import Link from '@/components/Link.astro'
import PageHead from '@/components/PageHead.astro'
import { Badge } from '@/components/ui/badge'
import { SOCIAL_LINKS } from '@/consts'
import Layout from '@/layouts/Layout.astro'
import { getAllPosts } from '@/lib/data-utils'
import { Icon } from 'astro-icon/components'

const KEYWORDS = [
  '인증·보안',
  'React',
  'Next.js',
  'TypeScript',
  '성능 최적화',
  'AI 활용 개발',
]

const STRENGTHS = [
  {
    icon: 'lucide:shield-check',
    title: '인증·보안',
    desc: 'HttpOnly 쿠키 하이브리드 인증을 직접 설계·운영했고, CSP·Refresh Token Rotation·CSRF·SameSite Lax 한계까지 프론트엔드에서 놓치기 쉬운 보안 영역을 깊이 다룹니다.',
    links: [
      {
        label: 'HttpOnly의 한계',
        href: '/blog/httponly-cookie-security-limits',
      },
      {
        label: '인증 아키텍처 설계',
        href: '/blog/authentication-architecture',
      },
      { label: '아키텍처 회고', href: '/blog/auth-architecture-retrospective' },
    ],
  },
  {
    icon: 'lucide:layout-template',
    title: '프론트엔드 아키텍처',
    desc: 'Next.js·React 기반으로 화면을 설계하고, 이미지 로드 시 레이아웃 시프트 같은 체감 품질 문제를 끝까지 파고들어 개선합니다.',
  },
  {
    icon: 'lucide:rocket',
    title: '제품 만들기',
    desc: 'AI 도구를 기획·구현·리팩토링 흐름에 넣어 MVP를 빠르게 만들고, 사용자 피드백 반영까지 혼자 끌고 갑니다.',
  },
]

const CAREER = [
  {
    role: '디자인',
    desc: '화면을 그리는 일에서 출발했습니다. 사용자가 무엇을 보고 어떻게 느끼는지 먼저 생각하는 습관이 여기서 생겼습니다.',
  },
  {
    role: '퍼블리싱',
    desc: '디자인을 코드로 옮기며 마크업·스타일·접근성을 익혔고, 자연스럽게 동작과 데이터에 관심이 옮겨갔습니다.',
  },
  {
    role: '프론트엔드 개발',
    desc: '사내 디자이너용 AI 이미지 생성 서비스를 프론트엔드 단독으로 1년 4개월 담당. 사용자 피드백 미팅·릴리즈 노트 작성 등 “일하는 방식”까지 만들며 성장했습니다.',
  },
]

const PROJECTS = [
  {
    title: '사내 AI 이미지 생성 서비스',
    meta: '프론트엔드 단독 · 1년 4개월',
    desc: '사내 디자이너가 AI로 이미지를 더 쉽게 만들도록 돕는 웹 서비스. Next.js 개발부터 K8s 배포, 사용자 피드백 미팅 도입, 릴리즈 노트 운영까지 담당했습니다.',
    href: '/blog/solo-frontend-lessons',
    linkLabel: '혼자 프론트를 담당하며 배운 것들 →',
  },
  {
    title: 'later-you-said · Emova',
    meta: '사이드 프로젝트 · AI 활용 MVP',
    desc: 'AI 도구를 기획·구현·리팩토링·지표 확인 흐름에 넣어 만든 두 개의 MVP. AI를 “생산성 도구”로 실제 제품 개발에 녹여본 경험입니다.',
    href: '/blog/ai-tools-product-building',
    linkLabel: 'AI 도구를 MVP 흐름에 넣은 기록 →',
  },
]

const SECURITY_SERIES = [
  {
    id: 'authentication-architecture',
    label: '1. 토큰을 어디에 저장할까',
    note: '세 가지 저장 전략을 비교하고 HttpOnly 하이브리드를 선택한 이유',
  },
  {
    id: 'httponly-cookie-security-limits',
    label: '2. HttpOnly만 믿으면 안 된다',
    note: 'XSS 활성 상태와 SameSite Lax의 세 가지 구조적 한계',
  },
  {
    id: 'auth-architecture-hard-parts',
    label: '3. 인증 아키텍처의 헷갈렸던 다섯 지점',
    note: '실제 구현에서 가장 시간이 많이 든 결정들',
  },
  {
    id: 'auth-architecture-retrospective',
    label: '4. 다시 한다면 어떻게 할까',
    note: '운영하며 아쉬웠던 결정과 다음에 바꿀 다섯 가지',
  },
]

const FEATURED_IDS = [
  'authentication-architecture',
  'auth-architecture-retrospective',
  'my-db-design-mistakes',
  'layout-shift-on-image-load',
  'solo-frontend-lessons',
]

const allPosts = await getAllPosts()
const featuredPosts = FEATURED_IDS.map((id) =>
  allPosts.find((post) => post.id === id),
).filter((post) => post !== undefined)

const securitySeriesPosts = SECURITY_SERIES.map((item) => {
  const post = allPosts.find((p) => p.id === item.id)
  return post ? { ...item, post } : null
}).filter((x) => x !== null)

// 연락 채널: GitHub·Email만 노출 (RSS 제외)
const contactLinks = SOCIAL_LINKS.filter((link) => link.label !== 'RSS')
---

<Layout>
  <PageHead
    slot="head"
    title="About"
    description="프론트엔드에서 인증·보안을 깊이 다루는 개발자 ari의 소개와 대표 작업. HttpOnly 하이브리드 인증, Refresh Token Rotation, CSRF, SameSite Lax 한계 등 실제 서비스에 적용한 경험을 기록합니다."
  />

  <section class="border-b pb-6">
    <p class="text-muted-foreground mb-2 text-sm">About</p>
    <h1 class="mb-3 text-2xl font-medium sm:text-3xl">
      프론트엔드에서 인증·보안을<br class="hidden sm:block" /> 끝까지 파고드는 개발자
    </h1>
    <p class="text-muted-foreground mb-4 text-sm">
      안녕하세요, 프론트엔드 개발자 ari입니다. HttpOnly 쿠키 하이브리드 인증을
      실제 서비스에 설계·운영한 1년 4개월 동안, 토큰 저장 전략·SameSite Lax
      한계·Refresh Token Rotation·CSRF 같은 프론트엔드가 놓치기 쉬운 보안
      영역을 깊이 다뤄왔습니다. 디자인·퍼블리싱을 거친 배경 덕에 화면의 완성도와
      체감 품질까지 함께 챙깁니다.
    </p>
    <div class="flex flex-wrap gap-2">
      {KEYWORDS.map((keyword) => <Badge variant="secondary">{keyword}</Badge>)}
    </div>
  </section>

  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">What I do</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        STRENGTHS.map((item) => (
          <li class="flex flex-col rounded-xl border p-4">
            <Icon name={item.icon} class="text-foreground mb-2 size-5" />
            <h3 class="mb-1 font-medium">{item.title}</h3>
            <p class="text-muted-foreground text-sm">{item.desc}</p>
            {item.links && (
              <ul class="mt-3 flex flex-col gap-1 border-t pt-3 text-sm">
                {item.links.map((link) => (
                  <li>
                    <Link
                      href={link.href}
                      class="text-foreground/70 hover:text-foreground transition-colors"
                    >
                      {link.label} →
                    </Link>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">경력</h2>
    <ol class="flex flex-col gap-y-4">
      {
        CAREER.map((step, index) => (
          <li class="flex gap-4">
            <div class="flex flex-col items-center">
              <span class="border-foreground/30 text-muted-foreground flex size-7 shrink-0 items-center justify-center rounded-full border text-xs">
                {index + 1}
              </span>
              {index < CAREER.length - 1 && (
                <span class="bg-border mt-1 w-px grow" />
              )}
            </div>
            <div class="pb-2">
              <h3 class="font-medium">{step.role}</h3>
              <p class="text-muted-foreground text-sm">{step.desc}</p>
            </div>
          </li>
        ))
      }
    </ol>
  </section>

  {
    securitySeriesPosts.length > 0 && (
      <section class="flex flex-col gap-y-4">
        <div class="flex items-center justify-between gap-4">
          <h2 class="text-2xl font-medium">Security 시리즈</h2>
          <Link
            href="/security"
            class="text-muted-foreground hover:text-foreground group flex shrink-0 items-center text-sm transition-colors"
          >
            전체 보기
            <span class="ml-1 transition-transform group-hover:translate-x-1">
              ›
            </span>
          </Link>
        </div>
        <p class="text-muted-foreground text-sm">
          프론트엔드 인증·보안을 처음부터 끝까지 따라가도록 4편의 글을 학습
          순서대로 정리했습니다. 토큰 저장 결정에서 출발해 실 운영 회고까지
          이어집니다.
        </p>
        <ol class="flex flex-col gap-y-2">
          {securitySeriesPosts.map((item) => (
            <li class="rounded-xl border p-4">
              <Link
                href={`/blog/${item.post.id}`}
                class="hover:text-foreground/80 block transition-colors"
              >
                <p class="text-foreground/60 text-xs">{item.label}</p>
                <h3 class="mt-1 font-medium">{item.post.data.title}</h3>
                <p class="text-muted-foreground mt-1 text-sm">{item.note}</p>
              </Link>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <section class="flex flex-col gap-y-4">
    <h2 class="text-2xl font-medium">대표 프로젝트</h2>
    <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2">
      {
        PROJECTS.map((project) => (
          <li class="flex h-full flex-col rounded-xl border p-4">
            <h3 class="font-medium">{project.title}</h3>
            <p class="text-muted-foreground mb-2 text-xs">{project.meta}</p>
            <p class="text-muted-foreground mb-3 grow text-sm">
              {project.desc}
            </p>
            <Link
              href={project.href}
              class="text-foreground/70 hover:text-foreground text-sm transition-colors"
            >
              {project.linkLabel}
            </Link>
          </li>
        ))
      }
    </ul>
  </section>

  {
    featuredPosts.length > 0 && (
      <section class="flex flex-col gap-y-4">
        <h2 class="text-2xl font-medium">대표 글</h2>
        <ul class="flex flex-col gap-y-4">
          {featuredPosts.map((post) => (
            <li>
              <BlogCard entry={post} />
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="flex flex-col gap-y-4 border-t pt-6">
    <h2 class="text-2xl font-medium">Contact</h2>
    <p class="text-muted-foreground text-sm">
      새로운 합류처를 찾고 있습니다. 함께 일하고 싶거나 궁금한 점이 있다면
      편하게 연락 주세요.
    </p>
  </section>
</Layout>
