---
import { Badge } from '@/components/ui/badge'
import { formatDate } from '@/lib/utils'
import type { CollectionEntry } from 'astro:content'
import Link from './Link.astro'
import ViewCount from './ViewCount.astro'

interface Props {
  entry: CollectionEntry<'knowledge'>
}

const { entry } = Astro.props
const formattedDate = formatDate(entry.data.updated)
---

<Link
  href={`/${entry.collection}/${entry.id}`}
  class="hover:bg-secondary/50 flex h-full flex-col gap-2 rounded-xl border p-4 transition-colors duration-300 ease-in-out"
>
  <Badge variant="secondary" className="w-fit">{entry.data.category}</Badge>
  <h3 class="line-clamp-2 text-base font-medium">{entry.data.title}</h3>
  <p class="text-muted-foreground line-clamp-3 grow text-sm">
    {entry.data.description}
  </p>
  <div
    class="text-muted-foreground mt-auto flex flex-wrap items-center gap-x-2 text-xs"
  >
    <span>갱신일 {formattedDate}</span>
    <ViewCount slug={`${entry.collection}/${entry.id}`} />
  </div>
</Link>
